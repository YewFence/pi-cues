#!/usr/bin/env bash
set -euo pipefail

release_tag="${RELEASE_TAG:?RELEASE_TAG is required}"
release_version="${RELEASE_VERSION:?RELEASE_VERSION is required}"

package_name="$(node -p "JSON.parse(require('node:fs').readFileSync('package.json', 'utf8')).name ?? ''")"
package_version="$(node -p "JSON.parse(require('node:fs').readFileSync('package.json', 'utf8')).version ?? ''")"
if [[ -z "${package_name}" || -z "${package_version}" ]]; then
  echo "package.json did not resolve a package name and version"
  exit 1
fi
if [[ "${package_version}" != "${release_version}" ]]; then
  echo "package.json version ${package_version} does not match release tag ${release_tag}"
  exit 1
fi

encoded_name="$(node -e 'process.stdout.write(encodeURIComponent(process.argv[1]))' "${package_name}")"
response_file="$(mktemp)"
trap 'rm -f "${response_file}"' EXIT
status="$(curl --silent --show-error \
  --user-agent "${package_name}-publish (https://github.com/YewFence/pi-cues)" \
  --output "${response_file}" \
  --write-out '%{http_code}' \
  "https://registry.npmjs.org/${encoded_name}/${package_version}")"
case "${status}" in
  200)
    echo "Package ${package_name} ${package_version} already exists"
    exit 0
    ;;
  404)
    echo "Package ${package_name} ${package_version} is not published yet"
    ;;
  *)
    echo "Could not determine npm status for ${package_name} ${package_version}: HTTP ${status}"
    cat "${response_file}"
    exit 1
    ;;
esac

aube publish --dry-run --no-git-checks

# Provenance needs an OIDC-capable CI environment; the first release is
# published from a local bootstrap checkout where no OIDC token exists.
provenance_args=()
if [[ -n "${ACTIONS_ID_TOKEN_REQUEST_URL:-}" || -n "${NPM_ID_TOKEN:-}" ]]; then
  provenance_args+=(--provenance)
fi
aube publish "${provenance_args[@]}" --no-git-checks
